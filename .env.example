# =============================================================================
# GitSync — copy to `.env` at repo root (never commit `.env`)
# =============================================================================
# Local dev: web http://localhost:3000 | API http://localhost:3001
# Beta:     web https://<project>.vercel.app | API https://<service>.onrender.com
# =============================================================================

NODE_ENV=development

# --- Database (Neon) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# --- Redis (Upstash) ---
REDIS_URL=rediss://default:TOKEN@HOST:6379

# --- Encryption (openssl rand -hex 32) ---
TOKEN_ENCRYPTION_KEY=737c456fd193032cdf6474a63d69de4341e18df8f94d47aec075e840c002cf7d

# --- Auth.js (shared: Vercel web + Render API) ---
# Generate: openssl rand -base64 32
AUTH_SECRET=ZCF2yJWaaGWrQ9F/topiF73Yeqtij4wV8ULNvd4nAQw=
# Vercel only — canonical app URL (Auth.js callbacks)
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# GitHub OAuth App for user sign-in (not the GitHub App installation)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Web (Vercel) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
# Shared secret for server-side proxy → API (openssl rand -hex 32)
INTERNAL_API_SECRET=

# --- API (Render) ---
PORT=3001
WEB_APP_URL=http://localhost:3000

# --- GitHub App (webhooks + repo access) ---
GITHUB_APP_ID=
# PEM contents or path; use \n for newlines in env
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# Register in GitHub App settings:
#   Webhook URL: https://<api-host>/webhooks/github

# --- LinkedIn OAuth (post publishing) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Register in LinkedIn app:
#   Redirect: https://<api-host>/integrations/linkedin/callback
LINKEDIN_REDIRECT_URI=http://localhost:3001/integrations/linkedin/callback

# --- Gemini AI ---
# Hosted beta model for structured draft generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Keep false for free-tier hosted beta unless private repo users explicitly consent.
GEMINI_ALLOW_PRIVATE_REPO_DRAFTING=false

# --- Feature flags / policy defaults ---
LINKEDIN_PROFILE_EDIT_ENABLED=false
DEFAULT_MAX_POSTS_PER_WEEK=3
WEBHOOK_RETENTION_DAYS=90
EVIDENCE_RETENTION_DAYS=90
