{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "pnpm --filter db run generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@GitSync/db": "workspace:*",
    "@GitSync/integrations": "workspace:*",
    "@auth/prisma-adapter": "^2.8.0",
    "openai": "^4.0.0",
    "@react-three/drei": "^9.95.1",
    "@react-three/fiber": "^8.15.5",
    "@sentry/nextjs": "^10.55.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.475.0",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.164.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-playwright": "^2.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8",
    "zod": "^3.22.4"
  },
  "reactDoctor": {
    "ignore": {
      "rules": [
        "deslop/unused-file",
        "deslop/unused-dependency",
        "deslop/unused-dev-dependency",
        "react-doctor/require-pnpm-hardening",
        "react-doctor/no-fetch-in-effect",
        "react-doctor/nextjs-no-client-fetch-for-server-data",
        "react-doctor/no-initialize-state",
        "react-doctor/prefer-useReducer",
        "react-doctor/no-giant-component",
        "react-doctor/no-multi-comp"
      ]
    }
  }
}
